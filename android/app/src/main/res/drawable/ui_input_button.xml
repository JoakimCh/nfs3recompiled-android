<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#303B72"/><corners android:radius="12dp"/><stroke android:width="3dp" android:color="@color/ui_accent"/></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#3B477E"/><corners android:radius="12dp"/><stroke android:width="2dp" android:color="@color/ui_accent"/></shape></item>
    <item android:state_activated="true"><shape><solid android:color="#3B355C"/><corners android:radius="12dp"/><stroke android:width="2dp" android:color="@color/ui_accent"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#26315F"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="@color/ui_accent"/></shape></item>
    <item><shape><solid android:color="#252E5D"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="#5A63A0"/></shape></item>
</selector>
